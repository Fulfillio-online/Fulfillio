# ==========================================
# Fulfillio Next.js Web Dockerfile
# ==========================================

FROM node:20-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable

WORKDIR /app

# Stage 1: Install & Build
FROM base AS builder
ARG NEXT_PUBLIC_API_URL=https://api.fulfillio.online/api
ARG NEXT_PUBLIC_APP_DOMAIN=fulfillio.online
ARG INTERNAL_API_URL=https://api.fulfillio.online/api

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_DOMAIN=$NEXT_PUBLIC_APP_DOMAIN
ENV INTERNAL_API_URL=$INTERNAL_API_URL

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages ./packages
COPY apps/web ./apps/web
COPY apps/api/package.json ./apps/api/package.json
COPY apps/worker/package.json ./apps/worker/package.json

RUN pnpm install --frozen-lockfile
RUN pnpm --filter=@fulfillio/contracts build
RUN pnpm --filter=@fulfillio/shared build
RUN pnpm --filter=@fulfillio/web build

# Stage 2: Production Runner
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/web ./apps/web

WORKDIR /app/apps/web
EXPOSE 3000

CMD ["./node_modules/.bin/next", "start", "-H", "0.0.0.0", "-p", "3000"]
