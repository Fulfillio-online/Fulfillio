{
    auto_https off
}

:80 {
    encode gzip zstd

    # NestJS API
    handle /api/* {
        reverse_proxy host.docker.internal:4000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Next.js Frontend
    handle {
        reverse_proxy host.docker.internal:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}
