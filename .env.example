# ==============================================================================
# Fulfillio Localhost & Development Environment Configuration
# ==============================================================================

# Server & Client Ports
PORT=4000
WEB_PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
POSTGRES_USER=fulfillio
POSTGRES_PASSWORD=fulfillio_secret
POSTGRES_DB=fulfillio_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://fulfillio:fulfillio_secret@localhost:5432/fulfillio_db?schema=public"

# Redis Configuration (BullMQ Jobs & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Secrets
JWT_SECRET=fulfillio_super_secret_access_key_change_in_production
JWT_ACCESS_SECRET=fulfillio_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=fulfillio_super_secret_refresh_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS & Domain Settings
CORS_ORIGIN=http://localhost:3000
APP_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
