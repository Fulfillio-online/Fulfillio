# Environment Configuration
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# PostgreSQL Configuration
POSTGRES_USER=fulfillio
POSTGRES_PASSWORD=fulfillio_secret
POSTGRES_DB=fulfillio_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fulfillio:fulfillio_secret@localhost:5432/fulfillio_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=fulfillio_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=fulfillio_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# App Domain
APP_DOMAIN=fulfillio.online
NEXT_PUBLIC_API_URL=http://localhost:4000/api
