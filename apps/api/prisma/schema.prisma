generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MerchantStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  MERCHANT
  RESELLER
  WAREHOUSE_OPERATOR
  COURIER_AGENT
}

enum OrderStatus {
  PENDING
  ON_HOLD_STOCK
  ON_HOLD_FRAUD
  ALLOCATED
  PICKING
  PACKED
  DISPATCHED
  DELIVERED
  PARTIAL_DELIVERED
  RETURNED
  CANCELLED
}

enum CourierProvider {
  STEADFAST
  PATHAO
  REDX
  PAPERFLY
  CUSTOM
}

enum InboundShipmentStatus {
  DRAFT
  IN_TRANSIT
  ARRIVED_AT_DOCK
  COMPLETED
  CANCELLED
}

enum StockMovementReason {
  INBOUND_ASN
  ORDER_RESERVED
  ORDER_CANCELLED
  RETURN_RESTOCK
  DAMAGED_QUARANTINE
  MANUAL_ADJUSTMENT
}

model Merchant {
  id                String         @id @default(uuid())
  merchantCode      String         @unique @default("MC-101")
  businessName      String
  email             String         @unique
  phone             String?
  location          String?        @default("Dhaka, Bangladesh")
  status            MerchantStatus @default(PENDING)
  payoutAccount     Json?          @db.JsonB
  socialChannels    Json?          @db.JsonB
  baseHandlingFee   Decimal        @default(50.00) @db.Decimal(10, 2)
  monthlyStorageFee Decimal        @default(2500.00) @db.Decimal(10, 2)
  apiKeyHash        String?
  webhookUrl        String?
  webhookSecret     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  users            User[]
  products         Product[]
  orders           Order[]
  memoTemplates    MemoTemplate[]
  settlements      Settlement[]
  inboundShipments InboundShipment[]
  auditLogs        InventoryAuditLog[]
  webhookDeliveryLogs WebhookDeliveryLog[]

  @@index([merchantCode])
  @@index([status])
  @@map("merchants")
}

model User {
  id           String    @id @default(uuid())
  merchantId   String?
  name         String
  email        String    @unique
  passwordHash String
  workerPin    String?
  role         UserRole  @default(MERCHANT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  merchant     Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, role])
  @@map("users")
}

model Product {
  id          String           @id @default(uuid())
  merchantId  String
  title       String
  description String?
  baseSku     String
  imageUrl    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  merchant    Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]

  @@unique([merchantId, baseSku])
  @@index([merchantId])
  @@map("products")
}

model ProductVariant {
  id             String                @id @default(uuid())
  productId      String
  sku            String                @unique
  barcode        String?               @unique
  title          String
  price          Decimal               @db.Decimal(10, 2)
  wholesalePrice Decimal?              @db.Decimal(10, 2)
  defaultBinCode String?               @default("A-01-01")
  attributes     Json?                 @db.JsonB
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  inboundItems   InboundShipmentItem[]
  auditLogs      InventoryAuditLog[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model InventoryLocation {
  id        String          @id @default(uuid())
  zone      String
  aisle     String
  rack      String
  shelf     String
  binCode   String          @unique
  isDamaged Boolean         @default(false)
  createdAt DateTime        @default(now())

  items     InventoryItem[]

  @@map("inventory_locations")
}

model InventoryItem {
  id                String            @id @default(uuid())
  variantId         String
  locationId        String
  quantityAvailable Int               @default(0)
  quantityReserved  Int               @default(0)
  quantityDamaged   Int               @default(0)
  reorderPoint      Int               @default(10)
  updatedAt         DateTime          @updatedAt

  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location          InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([variantId, locationId])
  @@index([variantId])
  @@index([locationId])
  @@map("inventory_items")
}

model InventoryAuditLog {
  id                String              @id @default(uuid())
  merchantId        String
  variantId         String
  quantityDelta     Int
  reason            StockMovementReason
  referenceId       String?
  performedByUserId String?
  notes             String?
  createdAt         DateTime            @default(now())

  merchant          Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  variant           ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([merchantId, variantId, createdAt])
  @@map("inventory_audit_logs")
}

model InboundShipment {
  id                  String                @id @default(uuid())
  merchantId          String
  asnCode             String                @unique
  status              InboundShipmentStatus @default(IN_TRANSIT)
  carrierName         String
  trackingReference   String?
  expectedArrivalDate DateTime
  receivedAt          DateTime?
  receivedByWorkerId  String?
  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  merchant            Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items               InboundShipmentItem[]

  @@index([merchantId, status])
  @@index([asnCode])
  @@map("inbound_shipments")
}

model InboundShipmentItem {
  id                      String          @id @default(uuid())
  inboundShipmentId       String
  variantId               String
  expectedQuantity        Int
  receivedGoodQuantity    Int             @default(0)
  receivedDamagedQuantity Int             @default(0)
  assignedBinCode         String?         @default("A-01-01")

  inboundShipment         InboundShipment @relation(fields: [inboundShipmentId], references: [id], onDelete: Cascade)
  variant                 ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([inboundShipmentId])
  @@index([variantId])
  @@map("inbound_shipment_items")
}

model Order {
  id                String           @id @default(uuid())
  merchantId        String
  externalOrderId   String?
  customerName      String
  customerPhone     String
  customerAddress   String
  city              String?
  status            OrderStatus      @default(PENDING)
  memoCode          String?          @default("MEMO-DEFAULT")
  isMemoPrinted     Boolean          @default(false)
  memoPrintedAt     DateTime?
  packagingType     String?          @default("POLY_SMALL")
  packagingCost     Decimal          @default(5.00) @db.Decimal(10, 2)
  customerRiskScore Int?             @default(92)
  customerRiskLevel String?          @default("SAFE")
  courierProvider   CourierProvider?
  consignmentId     String?
  trackingCode      String?
  totalAmount       Decimal          @db.Decimal(10, 2)
  codAmount         Decimal          @default(0) @db.Decimal(10, 2)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  merchant          Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  fulfillments      Fulfillment[]

  @@index([merchantId, status])
  @@index([memoCode])
  @@index([trackingCode])
  @@index([customerPhone])
  @@map("orders")
}

model OrderItem {
  id                  String         @id @default(uuid())
  orderId             String
  variantId           String
  quantity            Int
  unitPrice           Decimal        @db.Decimal(10, 2)
  isVerifiedAtPacking Boolean        @default(false)

  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant             ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model MemoTemplate {
  id         String   @id @default(uuid())
  merchantId String
  memoCode   String
  name       String
  isDefault  Boolean  @default(false)
  layout     Json     @db.JsonB
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, memoCode])
  @@index([merchantId])
  @@map("memo_templates")
}

enum FulfillmentStatus {
  PENDING
  PICKING
  PACKING
  SHIPPED
  COMPLETED
  CANCELLED
}

model Fulfillment {
  id          String            @id @default(uuid())
  merchantId  String
  orderId     String
  warehouseId String
  assignedTo  String?
  status      FulfillmentStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
  @@index([orderId])
  @@map("fulfillments")
}

model Settlement {
  id                String   @id @default(uuid())
  merchantId        String
  cycleStart        DateTime
  cycleEnd          DateTime
  totalCodCollected Decimal  @db.Decimal(10, 2)
  storageFees       Decimal  @db.Decimal(10, 2)
  handlingFees      Decimal  @db.Decimal(10, 2)
  packagingFees     Decimal  @default(0) @db.Decimal(10, 2)
  netPayout         Decimal  @db.Decimal(10, 2)
  isPaid            Boolean  @default(false)
  createdAt         DateTime @default(now())

  merchant          Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, isPaid])
  @@map("settlements")
}

model WebhookDeliveryLog {
  id           String    @id @default(uuid())
  merchantId   String
  event        String
  payload      Json      @db.JsonB
  endpointUrl  String
  attempts     Int       @default(1)
  statusCode   Int?
  responseBody String?
  isSuccess    Boolean   @default(false)
  failedReason String?
  nextRetryAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  merchant     Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, isSuccess])
  @@index([createdAt])
  @@map("webhook_delivery_logs")
}
