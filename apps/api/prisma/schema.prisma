generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MerchantStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  MERCHANT
  RESELLER
  WAREHOUSE_OPERATOR
  COURIER_AGENT
}

enum OrderStatus {
  PENDING
  ON_HOLD_STOCK
  ON_HOLD_FRAUD
  ALLOCATED
  PICKING
  PACKED
  DISPATCHED
  DELIVERED
  PARTIAL_DELIVERED
  RETURNED
  CANCELLED
}

enum CourierProvider {
  STEADFAST
  PATHAO
  REDX
  PAPERFLY
  CUSTOM
}

enum InboundShipmentStatus {
  DRAFT
  IN_TRANSIT
  ARRIVED_AT_DOCK
  COMPLETED
  CANCELLED
}

enum StockMovementReason {
  INBOUND_ASN
  ORDER_RESERVED
  ORDER_CANCELLED
  RETURN_RESTOCK
  DAMAGED_QUARANTINE
  MANUAL_ADJUSTMENT
}

enum ProductLifecycleStatus {
  DRAFT
  PENDING_APPROVAL
  AWAITING_STOCK
  ACTIVE
  REJECTED
  SUSPENDED
}

enum ProductEditState {
  NONE
  EDIT_REQUESTED
  EDIT_ALLOWED
  EDIT_APPROVAL_PENDING
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EditRequestType {
  EDIT_PERMISSION
  REVISION_APPROVAL
}

enum RestockRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  PARTIALLY_DISPATCHED
  DISPATCHED
  CANCELLED
}

enum InventoryTransactionType {
  INITIAL_STOCK_IN
  RESTOCK_IN
  RETURN_TO_MERCHANT
  MANUAL_ADJUSTMENT
  ORDER_RESERVED
  ORDER_FULFILLED
  ORDER_RELEASED
}

enum OrderEarningStatus {
  PENDING
  READY_TO_CLAIM
  CLAIMED
  REFUNDED
}

enum PayoutMethod {
  BKASH
  NAGAD
  ROCKET
  BANK_TRANSFER
  CASH
}

enum PayoutRequestStatus {
  PENDING
  ACCEPTED
  PAID
  REJECTED
  CANCELLED
}

enum FinanceEntryType {
  EXPENSE
  INCOME
}

enum FinanceEntryCategory {
  RENT
  SALARY
  COURIER_COST
  PACKAGING_PURCHASE
  UTILITY_MISC
  STORAGE_FEE
  OTHER_INCOME
}

model Merchant {
  id                String         @id @default(uuid())
  merchantCode      String         @unique @default("MC-101")
  businessName      String
  ownerName         String?        @default("Store Owner")
  email             String         @unique
  phone             String?
  location          String?        @default("Dhaka, Bangladesh")
  personalAddress   String?
  logoUrl           String?
  status            MerchantStatus @default(PENDING)
  payoutAccount     Json?          @db.JsonB
  kycData           Json?          @db.JsonB
  socialChannels    Json?          @db.JsonB
  baseHandlingFee   Decimal        @default(50.00) @db.Decimal(10, 2)
  monthlyStorageFee Decimal        @default(2500.00) @db.Decimal(10, 2)
  returnWindowDays  Int            @default(3)
  minPayoutAmount   Decimal        @default(100.00) @db.Decimal(10, 2)
  apiKeyHash        String?
  webhookUrl        String?
  webhookSecret     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  users            User[]
  products         Product[]
  orders           Order[]
  memoTemplates    MemoTemplate[]
  settlements      Settlement[]
  orderEarnings    OrderEarning[]
  payoutRequests   PayoutRequest[]
  inboundShipments InboundShipment[]
  auditLogs        InventoryAuditLog[]
  webhookDeliveryLogs WebhookDeliveryLog[]
  financeEntries   CompanyFinanceEntry[]

  @@index([merchantCode])
  @@index([status])
  @@map("merchants")
}

model User {
  id           String    @id @default(uuid())
  merchantId   String?
  name         String
  email        String    @unique
  passwordHash String
  workerPin    String?
  role         UserRole  @default(MERCHANT)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  merchant     Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, role])
  @@map("users")
}

model Product {
  id               String                 @id @default(uuid())
  merchantId       String
  title            String
  description      String?
  baseSku          String
  category         String?
  brand            String?
  purchasePrice    Decimal?               @db.Decimal(10, 2)
  sellingPrice     Decimal?               @db.Decimal(10, 2)
  weight           String?
  dimensions       String?
  imageUrl         String?
  images           String[]               @default([])
  status           String                 @default("PUBLISHED")
  lifecycleStatus  ProductLifecycleStatus @default(DRAFT)
  editState        ProductEditState       @default(NONE)
  isSuspended      Boolean                @default(false)
  suspendedReason  String?
  suspendedAt      DateTime?
  rejectionReason  String?
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  merchant         Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  variants         ProductVariant[]
  approvalRequests ProductApprovalRequest[]
  editRequests     ProductEditRequest[]
  restockRequests  RestockRequest[]
  returnRequests   ReturnRequest[]
  inventoryTxns    InventoryTransaction[]

  @@unique([merchantId, baseSku])
  @@index([merchantId])
  @@index([lifecycleStatus])
  @@map("products")
}

model ProductVariant {
  id             String                @id @default(uuid())
  productId      String
  sku            String                @unique
  barcode        String?               @unique
  title          String
  price          Decimal               @db.Decimal(10, 2)
  wholesalePrice Decimal?              @db.Decimal(10, 2)
  defaultBinCode String?               @default("A-01-01")
  imageUrl       String?
  attributes     Json?                 @db.JsonB
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  inboundItems   InboundShipmentItem[]
  auditLogs      InventoryAuditLog[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model InventoryLocation {
  id        String          @id @default(uuid())
  zone      String
  aisle     String
  rack      String
  shelf     String
  binCode   String          @unique
  isDamaged Boolean         @default(false)
  createdAt DateTime        @default(now())

  items     InventoryItem[]

  @@map("inventory_locations")
}

model InventoryItem {
  id                String            @id @default(uuid())
  variantId         String
  locationId        String
  quantityAvailable Int               @default(0)
  quantityReserved  Int               @default(0)
  quantityDamaged   Int               @default(0)
  reorderPoint      Int               @default(10)
  updatedAt         DateTime          @updatedAt

  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location          InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([variantId, locationId])
  @@index([variantId])
  @@index([locationId])
  @@map("inventory_items")
}

model InventoryAuditLog {
  id                String              @id @default(uuid())
  merchantId        String
  variantId         String
  quantityDelta     Int
  reason            StockMovementReason
  referenceId       String?
  performedByUserId String?
  notes             String?
  createdAt         DateTime            @default(now())

  merchant          Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  variant           ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([merchantId, variantId, createdAt])
  @@map("inventory_audit_logs")
}

model InboundShipment {
  id                  String                @id @default(uuid())
  merchantId          String
  asnCode             String                @unique
  status              InboundShipmentStatus @default(IN_TRANSIT)
  carrierName         String
  trackingReference   String?
  expectedArrivalDate DateTime
  receivedAt          DateTime?
  receivedByWorkerId  String?
  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  merchant            Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items               InboundShipmentItem[]

  @@index([merchantId, status])
  @@index([asnCode])
  @@map("inbound_shipments")
}

model InboundShipmentItem {
  id                      String          @id @default(uuid())
  inboundShipmentId       String
  variantId               String
  expectedQuantity        Int
  receivedGoodQuantity    Int             @default(0)
  receivedDamagedQuantity Int             @default(0)
  assignedBinCode         String?         @default("A-01-01")

  inboundShipment         InboundShipment @relation(fields: [inboundShipmentId], references: [id], onDelete: Cascade)
  variant                 ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([inboundShipmentId])
  @@index([variantId])
  @@map("inbound_shipment_items")
}

model Order {
  id                String           @id @default(uuid())
  merchantId        String
  externalOrderId   String?
  customerName      String
  customerPhone     String
  customerAddress   String
  city              String?
  status            OrderStatus      @default(PENDING)
  memoCode          String?          @default("MEMO-DEFAULT")
  isMemoPrinted     Boolean          @default(false)
  memoPrintedAt     DateTime?
  packagingType     String?          @default("POLY_SMALL")
  packagingCost     Decimal          @default(5.00) @db.Decimal(10, 2)
  customerRiskScore Int?             @default(92)
  customerRiskLevel String?          @default("SAFE")
  courierProvider   CourierProvider?
  consignmentId     String?
  trackingCode      String?
  totalAmount       Decimal          @db.Decimal(10, 2)
  codAmount         Decimal          @default(0) @db.Decimal(10, 2)
  subtotal          Decimal?         @default(0) @db.Decimal(10, 2)
  deliveryFee       Decimal?         @default(0) @db.Decimal(10, 2)
  discount          Decimal?         @default(0) @db.Decimal(10, 2)
  advancePayment    Decimal?         @default(0) @db.Decimal(10, 2)
  paymentMethod     String?
  paymentStatus     String?          @default("Unpaid")
  advancePaymentMethod String?
  advanceTrxId      String?
  cancelReason      String?
  cancelledAt       DateTime?
  isRestocked       Boolean          @default(false)
  restockedAt       DateTime?
  restockedBin      String?
  deliveredAt       DateTime?
  returnedAt        DateTime?
  timeline          Json?            @db.JsonB
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  merchant          Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  fulfillments      Fulfillment[]
  earning           OrderEarning?

  @@index([merchantId, status])
  @@index([memoCode])
  @@index([trackingCode])
  @@index([customerPhone])
  @@map("orders")
}

model OrderItem {
  id                  String          @id @default(uuid())
  orderId             String
  variantId           String?
  productTitle        String?
  variantLabel        String?
  sku                 String?
  quantity            Int
  unitPrice           Decimal         @db.Decimal(10, 2)
  isVerifiedAtPacking Boolean         @default(false)

  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model MemoTemplate {
  id         String   @id @default(uuid())
  merchantId String
  memoCode   String
  name       String
  isDefault  Boolean  @default(false)
  layout     Json     @db.JsonB
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, memoCode])
  @@index([merchantId])
  @@map("memo_templates")
}

enum FulfillmentStatus {
  PENDING
  PICKING
  PACKING
  SHIPPED
  COMPLETED
  CANCELLED
}

model Fulfillment {
  id          String            @id @default(uuid())
  merchantId  String
  orderId     String
  warehouseId String
  assignedTo  String?
  status      FulfillmentStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
  @@index([orderId])
  @@map("fulfillments")
}

model OrderEarning {
  id               String             @id @default(uuid())
  transactionRef   String             @unique
  merchantId       String
  orderId          String             @unique
  orderNumber      String
  itemSummary      String
  grossAmount      Decimal            @db.Decimal(12, 2)
  deliveryFee      Decimal            @default(0) @db.Decimal(10, 2)
  handlingFee      Decimal            @default(0) @db.Decimal(10, 2)
  packagingFee     Decimal            @default(0) @db.Decimal(10, 2)
  feeAmount        Decimal            @default(0) @db.Decimal(10, 2)
  netAmount        Decimal            @db.Decimal(12, 2)
  status           OrderEarningStatus @default(PENDING)
  returnWindowDays Int                @default(3)
  completedAt      DateTime
  claimableAt      DateTime
  claimedAt        DateTime?
  refundedAt       DateTime?
  refundReason     String?
  releasedByAdmin  Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  merchant         Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
  @@index([merchantId, claimableAt])
  @@index([merchantId, completedAt])
  @@map("order_earnings")
}

model PayoutRequest {
  id                String              @id @default(uuid())
  requestCode       String              @unique
  merchantId        String
  amount            Decimal             @db.Decimal(12, 2)
  method            PayoutMethod        @default(BKASH)
  provider          String
  accountNumber     String
  accountHolder     String?
  branchName        String?
  routingNumber     String?
  remarks           String?
  status            PayoutRequestStatus @default(PENDING)
  rejectionReason   String?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  trxId             String?
  proofDocumentUrl  String?             @db.Text
  proofDocumentName String?
  proofDocumentMime String?
  proofChannel      String?
  proofNotes        String?
  proofChecksum     String?
  paidAt            DateTime?
  paidByAdminId     String?
  paidByAdminName   String?
  requestedAt       DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  merchant          Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  settlement        Settlement?

  @@index([merchantId, status])
  @@index([status, requestedAt])
  @@map("payout_requests")
}

model Settlement {
  id                String         @id @default(uuid())
  merchantId        String
  payoutRequestId   String?        @unique
  transactionRef    String?
  paymentMethod     String?
  accountDetails    Json?          @db.JsonB
  proofDocumentUrl  String?        @db.Text
  proofDocumentName String?
  proofDocumentMime String?
  proofChecksum     String?
  remarks           String?
  cycleStart        DateTime
  cycleEnd          DateTime
  totalCodCollected Decimal        @db.Decimal(10, 2)
  storageFees       Decimal        @db.Decimal(10, 2)
  handlingFees      Decimal        @db.Decimal(10, 2)
  packagingFees     Decimal        @default(0) @db.Decimal(10, 2)
  netPayout         Decimal        @db.Decimal(10, 2)
  isPaid            Boolean        @default(false)
  paidAt            DateTime?
  createdAt         DateTime       @default(now())

  merchant          Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payoutRequest     PayoutRequest? @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)

  @@index([merchantId, isPaid])
  @@index([paidAt])
  @@map("settlements")
}

model WebhookDeliveryLog {
  id           String    @id @default(uuid())
  merchantId   String
  event        String
  payload      Json      @db.JsonB
  endpointUrl  String
  attempts     Int       @default(1)
  statusCode   Int?
  responseBody String?
  isSuccess    Boolean   @default(false)
  failedReason String?
  nextRetryAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  merchant     Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, isSuccess])
  @@index([createdAt])
  @@map("webhook_delivery_logs")
}

model ProductApprovalRequest {
  id              String                @id @default(uuid())
  productId       String
  merchantId      String
  requestedBy     String?
  status          ApprovalRequestStatus @default(PENDING)
  adminId         String?
  rejectionReason String?
  submittedAt     DateTime              @default(now())
  reviewedAt      DateTime?

  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([merchantId, status])
  @@map("product_approval_requests")
}

model ProductEditRequest {
  id               String                @id @default(uuid())
  productId        String
  merchantId       String
  requestType      EditRequestType       @default(EDIT_PERMISSION)
  status           ApprovalRequestStatus @default(PENDING)
  reason           String?
  requestedChanges Json?                 @db.JsonB
  originalSnapshot Json?                 @db.JsonB
  proposedSnapshot Json?                 @db.JsonB
  rejectionReason  String?
  adminId          String?
  createdAt        DateTime              @default(now())
  reviewedAt       DateTime?

  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([merchantId, status])
  @@map("product_edit_requests")
}

model RestockRequest {
  id                    String               @id @default(uuid())
  productId             String
  merchantId            String
  requestedQuantity     Int
  approvedQuantity      Int?
  receivedQuantity      Int                  @default(0)
  estimatedDeliveryDate DateTime?
  status                RestockRequestStatus @default(REQUESTED)
  notes                 String?
  rejectionReason       String?
  adminId               String?
  createdAt             DateTime             @default(now())
  reviewedAt            DateTime?
  completedAt           DateTime?

  product               Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([merchantId, status])
  @@map("restock_requests")
}

model ReturnRequest {
  id                 String              @id @default(uuid())
  productId          String
  merchantId         String
  requestedQuantity  Int
  approvedQuantity   Int?
  dispatchedQuantity Int                 @default(0)
  status             ReturnRequestStatus @default(REQUESTED)
  returnReason       String
  notes              String?
  courierName        String?
  trackingNumber     String?
  rejectionReason    String?
  adminId            String?
  createdAt          DateTime            @default(now())
  reviewedAt         DateTime?
  completedAt        DateTime?

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([merchantId, status])
  @@map("return_requests")
}

model InventoryTransaction {
  id              String                   @id @default(uuid())
  productId       String
  merchantId      String
  locationId      String?
  transactionType InventoryTransactionType
  quantity        Int
  referenceType   String?
  referenceId     String?
  performedBy     String?
  notes           String?
  createdAt       DateTime                 @default(now())

  product         Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([merchantId, transactionType])
  @@map("inventory_transactions")
}

model ActivityLog {
  id             String   @id @default(uuid())
  userId         String?
  action         String
  entityType     String
  entityId       String
  previousValues Json?    @db.JsonB
  newValues      Json?    @db.JsonB
  notes          String?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model InAppNotification {
  id              String   @id @default(uuid())
  recipientRole   UserRole
  recipientUserId String?
  merchantId      String?
  title           String
  message         String
  type            String
  linkUrl         String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([recipientRole, isRead])
  @@index([merchantId, isRead])
  @@index([createdAt])
  @@map("in_app_notifications")
}

model CompanyFinanceEntry {
  id                 String               @id @default(uuid())
  entryCode          String               @unique
  type               FinanceEntryType
  category           FinanceEntryCategory
  title              String
  amount             Decimal              @db.Decimal(12, 2)
  entryDate          DateTime             @default(now())
  merchantId         String?
  paymentMethod      String?
  referenceNo        String?
  notes              String?
  createdByAdminId   String?
  createdByAdminName String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  merchant           Merchant?            @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  @@index([type, entryDate])
  @@index([category, entryDate])
  @@index([merchantId, entryDate])
  @@map("company_finance_entries")
}
